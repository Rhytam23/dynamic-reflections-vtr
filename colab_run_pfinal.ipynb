    {
      "cell_type": "code",
      "metadata": {
        "id": "WmMN1BPI8SH6"
      },
      "execution_count": null,
      "outputs": [],
      "source": [
        "import logging\n",
        "logging.basicConfig(level=logging.INFO, format='%(asctime)s %(levelname)s %(message)s')\n",
        "from huggingface_hub import get_token\n",
        "from refactored_modules.config import PVDConfig\n",
        "from refactored_modules.utils import setup_environment, patch_scripts\n",
        "\n",
        "config = PVDConfig()\n",
        "setup_environment(config.repo_full_path)   # clone authors' repo, pin transformers<5, uv sync\n",
        "patch_scripts(config.repo_full_path)       # download_pvd.py + timm fixes\n",
        "REPO = config.repo_full_path\n",
        "HF_TOKEN = get_token()"
      ],
      "id": "WmMN1BPI8SH6"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "TmSiBSI18SH7"
      },
      "source": [
        "## 2. Data: download the PVD videos (about 1K)"
      ],
      "id": "TmSiBSI18SH7"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "rCXKG3VN8SH7"
      },
      "execution_count": null,
      "outputs": [],
      "source": [
        "from refactored_modules.pipeline import download_pvd_dataset\n",
        "download_pvd_dataset(config.dataset_json_path, config.dataset_output_dir, repo_path=REPO)"
      ],
      "id": "rCXKG3VN8SH7"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "hdOSvnt98SH7"
      },
      "source": [
        "## 3. Baseline: one real alignment score\n",
        "Extracts Gemma-2-2B-it text features (all 10 captions) and DINOv2-large video features (model default frames),\n",
        "then runs the layer x layer mutual k-NN sweep. The old `0.85` placeholder is gone; this number is measured."
      ],
      "id": "hdOSvnt98SH7"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "fLiDZfZ98SH7"
      },
      "execution_count": null,
      "outputs": [],
      "source": [
        "from refactored_modules.features import extract_features\n",
        "from refactored_modules.pipeline import run_alignment_pipeline\n",
        "\n",
        "FEAT = REPO / config.feature_dir\n",
        "extract_features(REPO, 'llm', llm_names=[config.llm_name], hf_token=HF_TOKEN)\n",
        "extract_features(REPO, 'video', video_names=[config.vision_name])\n",
        "\n",
        "result = run_alignment_pipeline(FEAT, config.llm_name, config.vision_name, k=config.k,\n",
        "                                output_json=REPO / config.results_dir / 'baseline.json')\n",
        "import json; print(json.dumps(result, indent=2))"
      ],
      "id": "fLiDZfZ98SH7"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "4r-KqDZO8SH7"
      },
      "execution_count": null,
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "from refactored_modules.plots import plot_layer_heatmap\n",
        "scores = np.load(REPO / config.results_dir / 'baseline.layers.npy')\n",
        "best = {'layer_x': result['best_vision_layer'], 'layer_y': result['best_llm_layer'],\n",
        "        'score': result['mutual_knn_score'], 'n': result['n'], 'k': result['k']}\n",
        "plot_layer_heatmap(scores, best, REPO / config.results_dir / 'figures' / 'layer_heatmap.png');\n",
        "from IPython.display import Image; Image(str(REPO / config.results_dir / 'figures' / 'layer_heatmap.png'))"
      ],
      "id": "4r-KqDZO8SH7"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "auiiXGUU8SH8"
      },
      "source": [
        "## 4. Sweeps: frames x captions, scaling-law fit, encoder comparison\n",
        "One extraction per frame count and per caption count (existing files are skipped, so a disconnected session can resume;\n",
        "features live on Drive). **This is the slow part**; shorten `config.frame_counts` to speed it up.\n",
        "VideoMAEv2 needs multiples of its 16-frame clip, so it gets its own frame grid."
      ],
      "id": "auiiXGUU8SH8"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "UuWaiPIH8SH8"
      },
      "execution_count": null,
      "outputs": [],
      "source": [
        "from refactored_modules import sweeps\n",
        "from refactored_modules.plots import plot_sweeps, plot_fit\n",
        "\n",
        "FRAME_GRIDS = {'dinov2_large_video': config.frame_counts, 'videomaev2_base': [16, 32, 48]}\n",
        "all_results = []\n",
        "for model in config.video_models:\n",
        "    frames = FRAME_GRIDS.get(model, config.frame_counts)\n",
        "    sweeps.extract_sweep_features(REPO, config.feature_dir, config.llm_name, model,\n",
        "                                  frames, config.caption_counts, hf_token=HF_TOKEN)\n",
        "    res = sweeps.compute_grid(FEAT, config.llm_name, model, frames, config.caption_counts, k=config.k,\n",
        "                              vision_pool=config.pool_for(model))\n",
        "    res = sweeps.fit_grid(res)\n",
        "    sweeps.save_result(res, REPO / config.results_dir / f'sweep_{model}.json')\n",
        "    all_results.append(res)"
      ],
      "id": "UuWaiPIH8SH8"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "mdxnUtUJ8SH8"
      },
      "execution_count": null,
      "outputs": [],
      "source": [
        "from IPython.display import Markdown, Image, display\n",
        "print(sweeps.comparison_table(all_results))\n",
        "plot_sweeps(all_results, REPO / config.results_dir / 'figures' / 'sweeps.png')\n",
        "display(Image(str(REPO / config.results_dir / 'figures' / 'sweeps.png')))\n",
        "for r in all_results:\n",
        "    if r['fit']:\n",
        "        plot_fit(r, REPO / config.results_dir / 'figures' / f\"fit_{r['vision']}.png\")\n",
        "# Paper (Gemma-2-9B): VideoMAEv2 C_f=0.15 vs DINOv2 C_f=0.05. Report whatever we measured above."
      ],
      "id": "mdxnUtUJ8SH8"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "twXumkwO8SH8"
      },
      "source": [
        "## 5. Video-to-text demo\n",
        "Held-out videos (20%) are matched to captions. The spaces differ in size, so a map is learned from the training pairs\n",
        "(ridge), or each item is described by its similarity to the training items (relative). Layers are chosen on the\n",
        "training split only. **Uses paired training data, so it is not zero-shot.**"
      ],
      "id": "twXumkwO8SH8"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "3re-4exn8SH8"
      },
      "execution_count": null,
      "outputs": [],
      "source": [
        "import json\n",
        "from refactored_modules.features import feature_path, load_features\n",
        "from refactored_modules.retrieval import evaluate_retrieval, top_captions\n",
        "from refactored_modules.colab_inference import sample_frames, generate_description\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "with open(REPO / config.dataset_json_path) as f:\n",
        "    samples = [json.loads(line) for line in f]\n",
        "video_feats = load_features(feature_path(FEAT, 'pvd', config.vision_name, config.vision_pool))\n",
        "text_feats = load_features(feature_path(FEAT, 'pvd', config.llm_name, config.llm_pool))\n",
        "assert len(samples) == len(video_feats) == len(text_feats), 'feature order must match the annotation file'\n",
        "\n",
        "ev = evaluate_retrieval(video_feats, text_feats, k_align=config.k)\n",
        "print({k: v for k, v in ev.items() if k != '_sims'})"
      ],
      "id": "3re-4exn8SH8"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "H-zvHTtp8SH8"
      },
      "execution_count": null,
      "outputs": [],
      "source": [
        "sim = ev['_sims']['ridge']\n",
        "first_caption = [s['rephrased_captions'][0] for s in samples]   # one caption per gallery video\n",
        "test_idx = ev['test_indices']\n",
        "for row in (0, 1, 2):\n",
        "    vid = samples[test_idx[row]]\n",
        "    retrieved_ids = sim[row].argsort()[::-1][:3]\n",
        "    retrieved = [first_caption[test_idx[j]] for j in retrieved_ids]\n",
        "    frames = sample_frames(REPO / config.dataset_output_dir / f\"{vid['video_id']}.bin\", 5)\n",
        "    fig, axes = plt.subplots(1, len(frames), figsize=(16, 3))\n",
        "    for ax, fr in zip(axes, frames): ax.imshow(fr); ax.axis('off')\n",
        "    plt.show()\n",
        "    print('True caption   :', first_caption[test_idx[row]])\n",
        "    print('Retrieved      :', retrieved)\n",
        "    print('Fused (Gemma)  :', generate_description(retrieved))\n",
        "    print('-' * 80)"
      ],
      "id": "H-zvHTtp8SH8"
    }
  ],
